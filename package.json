{
  "name": "pluginchek",
  "productName": "PluginChek",
  "version": "0.1.0-beta.2",
  "description": "Local DAW project plugin inspector",
  "author": "Sheldon Davidson <sheldon.davidson@gmail.com>",
  "homepage": "https://github.com/djshellshoxxx/pluginchek",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-syntax.mjs && node scripts/db-validate.mjs",
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage tar.gz",
    "dist:win": "electron-builder --win portable nsis",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:win:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.circuitdriftlabs.pluginchek",
    "productName": "PluginChek",
    "files": [
      "index.html",
      "styles.css",
      "ui-assistance.js",
      "parser-core.js",
      "src/**/*.js",
      "desktop/**",
      "LICENSE",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "PluginChek-${version}-${os}-${arch}.${ext}",
    "fileAssociations": [
      {
        "ext": "als",
        "name": "Ableton Live Set",
        "role": "Viewer"
      },
      {
        "ext": "rpp",
        "name": "REAPER Project",
        "role": "Viewer"
      },
      {
        "ext": "rpp-bak",
        "name": "REAPER Project Backup",
        "role": "Viewer"
      }
    ],
    "linux": {
      "category": "AudioVideo",
      "maintainer": "Sheldon Davidson <sheldon.davidson@gmail.com>"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "nsis": {
      "artifactName": "PluginChek-Setup-${version}-${arch}.exe",
      "oneClick": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "PluginChek-${version}-portable-${arch}.exe"
    }
  }
}
